{
  "rules": [
    {
      "id": "@secretlint/secretlint-rule-preset-recommend"
    },
    {
      "id": "@secretlint/secretlint-rule-pattern",
      "options": {
        "patterns": [
          {
            "name": "Fastmail API token (fmu1-)",
            "patterns": ["/fmu1-[A-Za-z0-9-]{20,}/"]
          },
          {
            "name": "Cloudflare API token (cfat_)",
            "patterns": ["/cfat_[A-Za-z0-9_]{20,}/"]
          }
        ]
      }
    }
  ]
}
