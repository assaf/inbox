#!/usr/bin/env bash
# Upgrade dependencies to latest. TypeScript 7.x (the native compiler) is now
# the stable line and builds fine on Vercel — it needs the explicit typeRoots
# in tsconfig.json, which the Vercel build checks. Any failing check aborts
# the script before the commit.
set -eo pipefail

echo -e "\033[32m  Upgrading pnpm …\033[0m"
pnpm self-update

echo -e "\033[32m  Upgrading dependencies …\033[0m"
pnpm update --latest
echo -e "\033[32m  Deduping dependencies …\033[0m"
pnpm dedupe --ignore-scripts
pnpm prune --ignore-scripts

echo -e "\033[32m  Checking …\033[0m"
pnpm check
pnpm test
pnpm secretlint
pnpm knip

echo -e "\033[32m  Build check (Vercel-equivalent) …\033[0m"
vercel build --yes

echo -e "\033[32m  Verifying runtime deps landed in the function bundles …\033[0m"
# A clean `vercel build` exit does not mean the tracer copied every runtime
# dependency: the nodemailer 10 upgrade passed this check while the built
# functions shipped without it, so every push crashed with
# ERR_MODULE_NOT_FOUND until a digest went unprocessed for a day.
for func in .vercel/output/functions/api/*.func; do
  case "$(basename "$func")" in
    push.func) required="nodemailer postal-mime linkedom http_ece" ;;
    cron.func) required="nodemailer postal-mime linkedom" ;;
    *) required="" ;;
  esac
  for dep in $required; do
    if ! ls "$func/node_modules/.pnpm/" 2>/dev/null | grep -q "^${dep}@"; then
      echo "Bundle check FAILED: $(basename "$func") is missing ${dep}." >&2
      exit 1
    fi
  done
done
echo -e "\033[32m  Bundle check passed.\033[0m"

echo -e "\033[32m  Auditing dependencies …\033[0m"
pnpm audit --prod || echo "Security audit failed"

echo -e "\033[32m  Committing changes …\033[0m"
git add package.json pnpm-lock.yaml
git commit -m "chore: upgrade dependencies" || echo

echo -e "\033[32m  Cleaning up …\033[0m"
git gc --prune=now || echo

echo -e "\033[32m  Checking for outdated dependencies …\033[0m"
pnpm outdated || true

terminal-notifier -sound default -title "$0" -message "Done!" || true
exit 0
