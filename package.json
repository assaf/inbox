{
  "name": "inbox",
  "version": "0.1.0",
  "private": true,
  "description": "Fastmail JMAP push -> clean USPS Informed Delivery -> back to Inbox",
  "type": "module",
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "typecheck": "tsc --noEmit",
    "lint": "vp lint",
    "check": "vp check --fix && knip && pnpm secretlint",
    "dry-run": "tsx scripts/dry-run.ts",
    "process": "tsx scripts/process.ts",
    "test": "pnpm check && vitest run",
    "test:watch": "vitest",
    "secretlint": "secretlint \"**/*\"",
    "knip": "knip",
    "dev": "portless run -- tsx scripts/dev.ts",
    "gen-assets": "tsx scripts/gen-assets.ts"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "^2.6.2",
    "http_ece": "^1.2.1",
    "linkedom": "^0.18.15",
    "nodemailer": "^10.3.1",
    "postal-mime": "^4.2.0"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-pattern": "^13.1.0",
    "@secretlint/secretlint-rule-preset-recommend": "^13.1.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@vercel/node": "^30.0.0",
    "knip": "^6.44.1",
    "portless": "^0.16.0",
    "secretlint": "^13.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite-plus": "^1.5.0",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.18.0"
}
