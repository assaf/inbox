{
  "name": "inbox",
  "version": "0.1.0",
  "private": true,
  "description": "Fastmail JMAP push -> clean USPS Informed Delivery -> back to Inbox",
  "type": "module",
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "typecheck": "tsc --noEmit",
    "lint": "vp lint",
    "check": "vp check --fix",
    "dry-run": "tsx scripts/dry-run.ts",
    "process": "tsx scripts/process.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "secretlint": "secretlint \"**/*\"",
    "knip": "knip",
    "dev": "portless run -- tsx scripts/dev.ts"
  },
  "dependencies": {
    "http_ece": "^1.2.1",
    "linkedom": "^0.18.13",
    "nodemailer": "^10.0.10",
    "postal-mime": "^3.0.0"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-pattern": "^13.0.5",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.5",
    "@types/node": "^26.6.2",
    "@types/nodemailer": "^8.0.2",
    "@vercel/node": "^14.0.0",
    "knip": "^6.38.0",
    "portless": "^0.15.6",
    "secretlint": "^13.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite-plus": "^1.0.0-rc.0",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@12.6.0"
}
