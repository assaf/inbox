{
  "name": "inbox",
  "version": "0.1.0",
  "private": true,
  "description": "Fastmail JMAP push -> clean USPS Informed Delivery -> back to Inbox",
  "type": "module",
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "typecheck": "tsc --noEmit",
    "lint": "vp lint",
    "check": "vp check --fix",
    "dry-run": "tsx scripts/dry-run.ts",
    "process": "tsx scripts/process.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "secretlint": "secretlint \"**/*\"",
    "knip": "knip",
    "dev": "portless run -- tsx scripts/dev.ts"
  },
  "dependencies": {
    "http_ece": "^1.2.1",
    "linkedom": "^0.18.13",
    "nodemailer": "^9.0.5",
    "postal-mime": "^3.0.0"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-pattern": "^13.0.4",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.4",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "@vercel/node": "^5.10.1",
    "knip": "^6.32.2",
    "portless": "^0.15.5",
    "secretlint": "^13.0.4",
    "tsx": "^4.23.12",
    "typescript": "^5.8.3",
    "vite-plus": "^0.2.9",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.22.0"
}
