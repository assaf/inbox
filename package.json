{
  "name": "inbox",
  "version": "0.1.0",
  "private": true,
  "description": "Fastmail JMAP push -> clean USPS Informed Delivery -> back to Inbox",
  "type": "module",
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "typecheck": "tsc --noEmit",
    "lint": "vp lint",
    "check": "vp check --fix && knip && pnpm secretlint",
    "dry-run": "tsx scripts/dry-run.ts",
    "process": "tsx scripts/process.ts",
    "test": "pnpm check && vitest run",
    "test:watch": "vitest",
    "secretlint": "secretlint \"**/*\"",
    "knip": "knip",
    "dev": "portless run -- tsx scripts/dev.ts"
  },
  "dependencies": {
    "http_ece": "^1.2.1",
    "linkedom": "^0.18.14",
    "nodemailer": "^10.2.1",
    "postal-mime": "^4.1.4"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-pattern": "^13.0.7",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@vercel/node": "^27.0.2",
    "knip": "^6.43.0",
    "portless": "^0.15.11",
    "secretlint": "^13.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite-plus": "^1.4.0",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.6.0"
}
